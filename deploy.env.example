# Настройки авто-деплоя (deploy.ps1). Скопируйте в deploy.env и заполните.
# deploy.env не попадает ни в git, ни в архив: секреты уходят только в .env на сервере.
# Если deploy.env нет, deploy.ps1 сам спросит обязательные значения и сохранит их сюда.

# Сервер
SERVER=root@5.42.115.41
SSH_PORT=2222
SERVER_IP=5.42.115.41
DOMAIN=sosed.pro
# Почта для сертификата Let's Encrypt (можно оставить пустой)
CERT_EMAIL=

# База PostgreSQL в Timeweb Cloud (спецсимволы в пароле кодируются: @ → %40, # → %23)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Вход в админ-панель /admin (без символов $ " ' \ и пробелов)
ADMIN_LOGIN=
ADMIN_PASSWORD=

# 1 — демо для показа: при пустой базе загрузить демо-мастеров и заказы, тестовая оплата,
#     код входа на экране, кнопка «Сброс». 0 — боевой режим (только каталоги, без демо).
DEMO=1
