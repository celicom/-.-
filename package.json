{
  "name": "sosed-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Сосед.ру — гиперлокальный агрегатор бытовых услуг в рамках ЖК (MVP)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-generate.mjs",
    "schema:local": "node scripts/sync-schema.mjs",
    "setup": "node scripts/prisma-generate.mjs && prisma db push --schema prisma/schema.local.prisma && prisma db seed",
    "db:push": "prisma db push --schema prisma/schema.local.prisma",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --schema prisma/schema.local.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "bot": "tsx scripts/bot.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
